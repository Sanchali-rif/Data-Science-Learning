


import pandas as pd
df=pd.read_csv("IRIS.csv")
df.head(10) # First 10 rows


print("shape-",df.shape) # show shape
df.dtypes          # show data type


df.describe() # Summary statistics





# petal_length>4.5
df.query("petal_length > 4.5") # or df[df["petal_length"] > 4.5]


df.query("species=='Iris-virginica'")  # species="Iris-virginica"





df.groupby("species").agg(
    avg_sepal_length=("sepal_length","mean"),
    max_petal_width=("petal_width","max"),
    std_sepal_width=("sepal_width","std")
)





df2=df.copy()
df2["petal_ratio"]=df2["petal_length"]/df2["petal_width"]
df2


df2.groupby("species")["petal_ratio"].mean()



