import pandas as pd
df=pd.read_csv("raw_data (1).csv")
df


#cleaning missing values
df.isnull()


df.isnull().sum() #count the number of nul in each column


df.dropna() #drop all therows with null values in our data


df.dropna(axis=1) #drop all the columns with null values in our data


df.fillna("null value filled") #can fill the null values with a pirticular value


cleaned_data=df.copy() #copy of the original data 
age_mean=cleaned_data["age"].mean() #mean of the age
cleaned_data["age"]=cleaned_data["age"].fillna(age_mean) #replace all the null age with mean age
cleaned_data


df.ffill() #forward fill


df.bfill() #backward fill


#handle duplicate datas
df.duplicated() #shows if any duplicate row is present or not


df["country"].duplicated() #check duplicate country


