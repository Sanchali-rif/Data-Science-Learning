import pandas as pd
#kaggel data set

df=pd.read_csv("globalAirQuality.csv")
df.tail()


df.head(10)


df.describe()


#selecting columns
df[["city","aqi"]] #multiple column selection


# rows selection - label based access and index based access
df.loc[0] #1st row data -label based


#we can do slicing also-
df.loc[0:4] #the ending idx is inclusive


df.iloc[2]  #index value are access
df.iloc[0:2] #ending index is exclusive


#row and column both access (labeled based)
print(df.loc[0,"aqi"]) # aqi value in 0th row
print(df.loc[0,["city","aqi"]]) #multuple columns in 0th row


df.loc[0:2,["city","aqi"]]


#row and column both access (index based)
df.iloc[0:2,1:6] # 0th row and 1st column


#cell
print(df.at[0,"city"]) #label
print(df.iat[0,2])  #index


#filtering of data

