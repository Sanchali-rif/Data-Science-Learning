import pandas as pd
#kaggel data set

df=pd.read_csv("globalAirQuality.csv")
df.tail()


df.head(10)


df.describe()


#selecting columns
df[["city","aqi"]] #multiple column selection


# rows selection - label based access and index based access
df.loc[0] #1st row data -label based


#we can do slicing also-
df.loc[0:4] #the ending idx is inclusive


df.iloc[2]  #index value are access
df.iloc[0:2] #ending index is exclusive


#row and column both access (labeled based)
print(df.loc[0,"aqi"]) # aqi value in 0th row
print(df.loc[0,["city","aqi"]]) #multuple columns in 0th row


df.loc[0:2,["city","aqi"]]


#row and column both access (index based)
df.iloc[0:2,1:6] # 0th row and 1st column


#cell
print(df.at[0,"city"]) #label
print(df.iat[0,2])  #index


#filtering of data
df[df["aqi"]>100] # show data that has aqi>100


df[(df["aqi"]>100) & (df["temperature"]>30)] #show data that has aqi>100 and temperature>30 degrees


aqi_data = df[(df["aqi"] > 100) & (df["temperature"] > 30)][["city", "aqi"]] #if aui>100 and temp>30 print the city and aqi column

# aqi_data.iloc[0] will show the 1st row since its showing label
# aqi_data.iloc[0] will give error since the index 0 is not present in the table here
aqi_data.loc[6]


#query()
df.query("aqi>100 & temperature>30")


df.query("aqi>100 & temperature>30")[["city","aqi"]]


aqi_value=160
df.query("aqi>@aqi_value & temperature>30")[["city","aqi"]] #refer to qui_value via @



