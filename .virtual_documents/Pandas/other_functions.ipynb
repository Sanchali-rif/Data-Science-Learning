# Merging and joining Data

df_customers=pd.DataFrame({
    "customer_id":[1,2,3,4],
    "name":["Adam","Bob","Charlie","Dave"]
})
df_orders=pd.DataFrame({
    "order_id":[101,102,103,104],
    "customer_id":[2,1,4,5],
    "amount":[250,120,300,180]
})


df_customers


df_orders


inner_join=pd.merge(df_customers,df_orders,on="customer_id")
inner_join  # join the tables based on common attribute


left_join=pd.merge(df_customers,df_orders,on="customer_id",how="left")
left_join # keeps all rows from the first table and only the matching rows from the second table


right_join=pd.merge(df_customers,df_orders,on="customer_id",how="right")
right_join  # keeps all data from the left table, plus any matching data from the right table


outer_join=pd.merge(df_customers,df_orders,on="customer_id",how="outer")
outer_join #  combines data from two tables, keeping rows even if they do not match


# Concatination
df1=pd.DataFrame({
    "id":[1,2,3],
    "name":["Adam","Eve","Bob"]
})
df2=pd.DataFrame({
    "id":[4,5,6],
    "name":["Charlei","Fester","Gillian"]
})
pd.concat([df1,df2])   # row wise
pd.concat([df1,df2],ignore_index=True)  # to remove preserved lebels


pd.concat([df1,df2],axis=1) # column wise
