import pandas as pd
df=pd.read_csv("raw_data (1).csv")
df


# Grouping & aggregation of data
df.groupby("country")["income"].mean() # mean income for each country


df.groupby("country")["income"].min() # minimum income of each country


df.groupby("country")["income"].max() # maximum income of each country


df.groupby("gender")["income"].mean() # mean income of each gender


df.groupby("country")["income"].agg(["mean","min","max"]) #multiple function together
# or we can rename the aggregate values
df.groupby("country")["income"].agg(avg_salary="mean",min_salary="min",max_salary="max")


# we can aggregate in each column also with different function
df.groupby("country").agg({
    "income":"max",
    "age":"mean"
})
# we can rename the coulmn also
df.groupby("country").agg(
    max_salary=("income","max"),
    avg_age=("age","mean")
)


# Melt - wide to long formate data
df=pd.DataFrame({
    "country":["USA","USA","India","India"],
    "year":[2020,2021,2020,2021],
    "sales":[100,120,90,110],
    "profit":[20,25,18,22],
    "Tax":[10,20,30,40]
})
df #wide data formate


melted_data=df.melt( 
    id_vars=["country","year"], # data to keep as it is
    value_vars=["sales","profit","Tax"], # data to melt into 1 single column
    var_name="metrics", # name of the column
    value_name="value" # value of the melted column value
)
melted_data # melted data - long format


# pivot - long to wide format data
original_data=melted_data.pivot(
    index=["country","year"], # every row should be unique
    columns="metrics",  # create columns with the unique values
    values="value"  # value of every column
)
original_data


